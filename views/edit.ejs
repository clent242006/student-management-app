<!DOCTYPE html>
<html>
<head>
    <title>Edit Student</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <h1>Edit Student</h1>

    <form action="/edit/<%= student.id %>" method="POST">

        <label>Student Name</label>
        <input
            type="text"
            name="name"
            value="<%= student.name %>"
            required
        >

        <label>Course</label>
        <input
            type="text"
            name="course"
            value="<%= student.course %>"
            required
        >

        <label>Year</label>
        <input
            type="number"
            name="year"
            value="<%= student.year %>"
            min="1"
            max="5"
            required
        >

        <button type="submit">Update Student</button>

    </form>

    <br>

    <a href="/">← Back to Students</a>

</div>

</body>
</html>