<%- include('partials/head', { title }) %>

<div class="container">

    <h1>Edit Student</h1>

    <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/edit/<%= student.id %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label>Student Name</label>
        <input
            type="text"
            name="name"
            value="<%= typeof values !== 'undefined' ? values.name : student.name %>"
            required
        >

        <label>Course</label>
        <input
            type="text"
            name="course"
            value="<%= typeof values !== 'undefined' ? values.course : student.course %>"
            required
        >

        <label>Year</label>
        <input
            type="number"
            name="year"
            value="<%= typeof values !== 'undefined' ? values.year : student.year %>"
            min="1"
            max="5"
            required
        >

        <button type="submit">Update Student</button>

    </form>

    <br>

    <a href="/">← Back to Students</a>

</div>

<%- include('partials/footer') %>