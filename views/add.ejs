<%- include('partials/head', { title }) %>

<div class="container">

    <h1>Add Student</h1>

    <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label>Student Name</label>
        <input
            type="text"
            name="name"
            value="<%= typeof values !== 'undefined' ? values.name : '' %>"
            required
        >

        <label>Course</label>
        <input
            type="text"
            name="course"
            placeholder="BSIT"
            value="<%= typeof values !== 'undefined' ? values.course : '' %>"
            required
        >

        <label>Year</label>
        <input
            type="number"
            name="year"
            min="1"
            max="5"
            value="<%= typeof values !== 'undefined' ? values.year : '' %>"
            required
        >

        <button type="submit">Save Student</button>
    </form>

    <br>

    <a href="/">← Back to Students</a>

</div>

<%- include('partials/footer') %>